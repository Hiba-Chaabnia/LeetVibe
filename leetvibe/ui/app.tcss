/* ============================================================
   LeetVibe TUI — Fire-gradient dark theme
   ============================================================ */

/* --- Color palette --- */
$grad1: #FFD700;
$grad2: #FFAF00;
$grad3: #FF8205;
$grad4: #FA500F;
$grad5: #E92700;

$brand: #FF8205;
$easy: #00C44F;
$medium: #FFB300;
$hard: #E53935;
$blue: #4A9EFF;
$trading: #00BCD4;
$amber: #FFB300;
$muted: #888888;
$text: #e0e0e0;
$bg: #121212;
$bg-card: #0e0e0e;
$bg-raised: #1a1a1a;


/* ============================================================
   Global
   ============================================================ */

Screen {
    background: $bg;
    color: $text;
}


/* ============================================================
   HomeScreen
   ============================================================ */

#home-banner {
    text-align: center;
    height: auto;
    padding: 1 4;
    color: $grad1;
}

#home-scroll {
    height: 1fr;
    align: center middle;
}

#home-content {
    height: auto;
    width: auto;
    align: center middle;
}

#home-center {
    width: auto;
    height: auto;
    align: center middle;
    padding: 1 4;
}

#main-menu {
    width: auto;
    border: round $brand;
    background: transparent;
    padding: 1 2;
}

#main-menu > .option-list--option {
    padding: 0 1;
    color: $text;
}

#main-menu > .option-list--option-highlighted {
    background: $brand;
    color: #000000;
    text-style: bold;
}

#home-status {
    dock: bottom;
    height: 1;
    background: transparent;
    padding: 0 2;
    color: $muted;
}



/* ============================================================
   ProblemListScreen
   ============================================================ */

/* ── filters and search bar container ── */
#list-header {
    height: auto;
    background: transparent;
    padding: 0 1;
    align: left middle;
}

/* ── difficulty-filter  (grad1 GOLD) ── */
#difficulty-filter {
    width: 22;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}

#difficulty-filter:focus-within,
#difficulty-filter.filter-active {
    border: round $grad1;
    color: $grad1;
}

#difficulty-filter > SelectCurrent,
#topic-filter > SelectCurrent,
#solved-filter > SelectCurrent { overflow: hidden; border: none; padding: 0 1; color: $muted; }
#feedback-type > SelectCurrent { overflow: hidden; border: none; padding: 0 1; }

#difficulty-filter > SelectCurrent > #label,
#topic-filter > SelectCurrent > #label,
#solved-filter > SelectCurrent > #label { overflow: hidden; color: $muted; }
#feedback-type > SelectCurrent > #label { overflow: hidden; }

#difficulty-filter:focus-within > SelectCurrent,
#difficulty-filter.filter-active > SelectCurrent { color: $grad1; }
#difficulty-filter:focus-within > SelectCurrent > #label,
#difficulty-filter.filter-active > SelectCurrent > #label { color: $grad1; }

#topic-filter:focus-within > SelectCurrent,
#topic-filter.filter-active > SelectCurrent { color: $grad2; }
#topic-filter:focus-within > SelectCurrent > #label,
#topic-filter.filter-active > SelectCurrent > #label { color: $grad2; }

#solved-filter:focus-within > SelectCurrent,
#solved-filter.filter-active > SelectCurrent { color: $grad3; }
#solved-filter:focus-within > SelectCurrent > #label,
#solved-filter.filter-active > SelectCurrent > #label { color: $grad3; }

/* ── topic-filter  (grad2 HONEY) ── */
#topic-filter {
    width: 26;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}

#topic-filter:focus-within,
#topic-filter.filter-active {
    border: round $grad2;
    color: $grad2;
}

/* ── solved-filter  (grad3 FIRE) ── */
#solved-filter {
    width: 20;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}

#solved-filter:focus-within,
#solved-filter.filter-active {
    border: round $grad3;
    color: $grad3;
}

/* ── btn-solution-toggle  (grad4 EMBER) ── */
#btn-solution-toggle {
    width: auto;
    min-width: 18;
    height: 3;
    margin: 0 1;
    border: round $muted;
    background: transparent;
    color: $muted;
    content-align: center middle;
}

#btn-solution-toggle:hover {
    border: round $grad4;
    color: $grad4;
}

#btn-solution-toggle.sol-active {
    color: $grad4;
    border: round $grad4;
}

/* ── search-input  (grad5 LAVA) ── */
#search-input {
    width: 1fr;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}

#search-input:focus,
#search-input.filter-active {
    border: round $grad5;
    color: $grad5;
}

/* ── Problem Table── */

ProblemTable {
    height: 1fr;
    background: transparent;
    border: round $muted;
    overflow-x: auto;
}

ProblemTable > .datatable--header {
    background: #1e1e1e;
}

ProblemTable > .datatable--cursor {
    background: $brand;
    color: #000000;
    text-style: bold;
}

ProblemTable > .datatable--even-row {
    background: transparent;
}

ProblemTable > .datatable--odd-row {
    background: transparent;
}

#list-status {
    dock: bottom;
    height: 1;
    background: transparent;
    padding: 0 2;
    color: $muted;
}


/* ============================================================
   ProblemDetailScreen
   ============================================================ */

/* ── Top bar ── */
#top-bar {
    height: 4;
    background: transparent;
    padding: 0 1;
}

#detail-status {
    background: transparent;
}

#nav-section    { width: 1fr; align: left middle; }
#action-section { width: 1fr; align: center middle; }
#sol-section    { width: 1fr; align: right middle; }

#btn-problem-list, #btn-prev, #btn-next,
#btn-run, #btn-submit, #btn-feedback, #btn-solution {
    background: transparent;
    padding: 0 1;
    min-width: 0;
    height: 3;
}

#btn-problem-list:focus, #btn-prev:focus, #btn-next:focus,
#btn-run:focus, #btn-submit:focus, #btn-feedback:focus, #btn-solution:focus,
#btn-problem-list.-active, #btn-prev.-active, #btn-next.-active,
#btn-run.-active, #btn-submit.-active, #btn-feedback.-active, #btn-solution.-active {
    background: transparent;
}

#btn-problem-list, #btn-prev, #btn-next { color: $muted; border: round #444444; text-style: dim; }
#btn-prev:disabled, #btn-next:disabled  { color: #444444; border: round #2a2a2a; }
#btn-run                                { color: $easy;  border: round $easy; }
#btn-submit                             { color: $blue;  border: round $blue; }
#btn-feedback                           { color: $muted; border: round $muted; }
#btn-solution                           { color: #FFD700; border: round #7A6500; text-style: dim; }

#btn-submit:disabled { color: #444444; border: round #444444; }

/* ── Main body ── */
#detail-body {
    height: 1fr;
    padding: 0 1;
    margin-bottom: 2;
}

/* ── Left panel ── */
#left-panel {
    width: 1fr;
    border: round $brand;
    margin: 0 1 0 0;
}
#left-scroll {
    height: 1fr;
    padding: 1 2;
}

/* ── Right panel ── */
#right-panel {
    width: 1fr;
    margin: 0 0 0 1;
}

#editor-panel {
    height: 4fr;
    border: round $brand;
    margin-bottom: 0;
}
#code-editor { height: 1fr; }

/* ── Bottom tabs ── */
#testcase-tabs              { height: 1fr; border: round $brand; }
#testcase-table, #result-table { height: 1fr; }

#solution-explanation {
    height: auto;
    color: $text;
    padding: 1 2;
    text-align: left;
}
#no-solution-msg {
    padding: 1 2;
    color: $muted;
    text-style: italic;
}

/* ── Utilities ── */
.hidden {
    display: none;
}

/* Header override */
Header {
    background: transparent;
    color: $grad2;
    text-style: bold;
    border-bottom: solid $brand;
}


/* ============================================================
   Select widget
   ============================================================ */

Select {
    background: transparent;
    border: tall $muted;
    color: $text;
    width: 22;
}

Select > SelectCurrent {
    color: $text;
    background: transparent;
}

Select > SelectOverlay {
    background: transparent;
    border: tall $brand;
}

Select > SelectOverlay > .option-list--option {
    color: $text;
}

Select > SelectOverlay > .option-list--option-highlighted {
    background: $brand;
    color: #000000;
}


/* ============================================================
   Input widget
   ============================================================ */

Input {
    background: transparent;
    border: tall $muted;
    color: $text;
}

Input:focus {
    border: tall $brand;
}

/* ── Feedback modal select override ── */
#feedback-type {
    width: 100%;
    border: round $muted;
}

#feedback-type:focus-within {
    border: round $brand;
}

/* ── Login screen input overrides ── */
#login-container Input {
    border: round #555555;
}

#login-container Input:focus {
    border: round $brand;
}

#login-container Input:disabled {
    border: round #333333;
}

/* ============================================================
   Loading indicator
   ============================================================ */

LoadingIndicator {
    color: $brand;
}


/* ============================================================
   Tooltip
   ============================================================ */

Tooltip {
    background: $bg-raised;
    color: $text;
    border: round $muted;
    padding: 0 1;
}


/* ============================================================
   Banner widget
   ============================================================ */

Banner {
    text-align: center;
    padding: 1 2;
    height: auto;
}


/* ============================================================
   StatusBar / HintLabel widgets
   ============================================================ */

StatusBar {
    height: 1;
    background: #16213e;
    padding: 0 2;
    dock: bottom;
}
StatusBar Label {
    color: $muted;
}
StatusBar #status-hints {
    width: auto;
    height: 1;
    padding: 0;
}
HintLabel {
    height: 1;
    width: auto;
    padding: 0 1;
    background: transparent;
}
HintLabel:hover {
    background: #2a2a2a;
}
StatusBar .hint-sep {
    color: #555555;
    width: auto;
    height: 1;
    padding: 0 0;
}
StatusBar #status-left   { width: 1fr; }
StatusBar #status-spacer { width: 1fr; }
StatusBar #status-right  { width: auto; }
StatusBar.hints-centered #status-count { width: 1fr; }
StatusBar.hints-centered #status-right { width: 1fr; text-align: right; }


/* ============================================================
   ProblemCard widget
   ============================================================ */

ProblemCard {
    height: auto;
    text-align: left;
}
ProblemCard #card-title {
    height: auto;
    padding: 0 0 1 0;
    color: white;
    text-style: bold;
    text-align: left;
}
ProblemCard #tags-row {
    height: auto;
}
ProblemCard .badge {
    height: 1;
    width: auto;
    padding: 0 1;
    margin: 0 1 0 0;
    background: #2a2a2a;
    color: #aaaaaa;
}
ProblemCard .badge-easy    { background: #1a3a1a; color: $easy; }
ProblemCard .badge-medium  { background: #3a2a00; color: $amber; }
ProblemCard .badge-hard    { background: #3a1010; color: $hard; }
ProblemCard .badge-trading { background: #0a2a2a; color: $trading; }
ProblemCard .badge-topic   { background: #252525; color: #aaaaaa; }
ProblemCard #card-description {
    height: auto;
    color: $text;
    padding: 1 0;
    border-top: solid #333333;
    margin-top: 1;
    text-align: left;
}
ProblemCard #hints-placeholder {
    color: $muted;
    text-style: italic;
    padding: 1 0;
    border-top: solid #333333;
    margin-top: 1;
}
ProblemCard #hints-content {
    height: auto;
    color: $amber;
    padding: 1 0;
    border-top: solid #333333;
    margin-top: 1;
}
ProblemCard .hidden {
    display: none;
}


/* ============================================================
   LoginScreen
   ============================================================ */

LoginScreen {
    align: center middle;
}
#login-container {
    width: 58;
    height: auto;
    border: round $brand;
    background: $bg-card;
    padding: 1 2 2 2;
}
#login-title {
    width: 100%;
    content-align: center middle;
    color: $brand;
    text-style: bold;
    margin: 0 0 1 0;
    height: 1;
}
#mode-row {
    height: 3;
    width: 100%;
    align: center middle;
    margin: 0 0 1 0;
}
#btn-signin-mode, #btn-signup-mode {
    border: round #444444;
    background: transparent;
    color: $muted;
    padding: 0 2;
    min-width: 12;
    height: 3;
}
#btn-signin-mode.active, #btn-signup-mode.active {
    background: #3a2200;
    color: $brand;
    text-style: bold;
    border: round $brand;
}
#btn-signin-mode:focus, #btn-signin-mode.-active,
#btn-signup-mode:focus, #btn-signup-mode.-active {
    background: transparent;
}
#btn-signin-mode.active:focus, #btn-signin-mode.active.-active,
#btn-signup-mode.active:focus, #btn-signup-mode.active.-active {
    background: #3a2200;
}
#login-status {
    width: 100%;
    color: $muted;
    height: 1;
    text-align: center;
    margin: 0 0 1 0;
}
#btn-google {
    width: 100%;
    border: round $muted;
    background: transparent;
    color: #e0e0e0;
    height: 3;
}
#btn-google:hover    { background: $bg-raised; border: round #aaaaaa; }
#btn-google:disabled { color: #444444; border: round #333333; }
#btn-google:focus, #btn-google.-active { background: transparent; }
LoginScreen #divider {
    width: 100%;
    content-align: center middle;
    color: $muted;
    margin: 1 0;
    height: 1;
}
#confirm-input {
    display: none;
}
#google-note {
    width: 100%;
    color: $muted;
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    text-align: center;
    text-style: italic;
}
LoginScreen #btn-submit {
    width: 100%;
    margin: 1 0 0 0;
    background: $brand;
    color: #000000;
    text-style: bold;
    border: none;
    height: 3;
}
LoginScreen #btn-submit:hover    { background: $amber; }
LoginScreen #btn-submit:disabled { background: #3a2200; color: #555555; }
#login-error {
    width: 100%;
    color: $hard;
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    text-align: center;
}
#login-info {
    width: 100%;
    color: $easy;
    height: auto;
    min-height: 1;
    margin: 0;
    text-align: center;
}


/* ============================================================
   StatsScreen
   ============================================================ */

StatsScreen {
    background: $bg;
}
#stats-scroll {
    height: 1fr;
    padding: 1 2;
}
.stat-card {
    padding: 1 2;
    height: auto;
    background: $bg-card;
}
#progress-card {
    border: round $grad1;
    margin-bottom: 1;
}
#mid-row {
    height: 11;
    margin-bottom: 1;
}
#sessions-card {
    border: round $brand;
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}
#account-card {
    border: round $grad4;
    width: 1fr;
    height: 1fr;
}
#library-card {
    border: round $grad5;
    margin-top: 1;
}
#stats-status {
    background: $bg;
}


/* ============================================================
   NotesModal
   ============================================================ */

NotesModal {
    align: center middle;
}
#notes-dialog {
    width: 72;
    height: 24;
    background: $bg-raised;
    border: round $brand;
    padding: 1 2;
}
#notes-title {
    color: $grad1;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}
#notes-hint {
    color: #555555;
    height: 1;
    margin-bottom: 1;
}
#notes-area {
    height: 13;
    border: round #444444;
    background: $bg-card;
}
#notes-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}
#notes-buttons Button {
    margin-left: 1;
    background: transparent;
    min-width: 14;
}
NotesModal #btn-save {
    color: $brand;
    border: round $brand;
}
NotesModal #btn-cancel {
    color: $muted;
    border: round #444444;
}


/* ============================================================
   FeedbackModal
   ============================================================ */

FeedbackModal {
    align: center middle;
}
#feedback-dialog {
    width: 72;
    height: auto;
    background: $bg-raised;
    border: round $brand;
    padding: 2 3;
}
#feedback-title {
    color: $brand;
    text-style: bold;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}
#feedback-type-label {
    color: $muted;
    margin-bottom: 0;
}
#feedback-type {
    width: 100%;
    margin-bottom: 1;
}
#feedback-msg-label {
    color: $muted;
    margin-bottom: 0;
}
#feedback-text {
    width: 100%;
    height: 8;
    border: round #444444;
    background: $bg;
    margin-bottom: 1;
}
#feedback-text:focus {
    border: round $brand;
}
#feedback-error {
    color: #ff4444;
    height: auto;
    min-height: 1;
    width: 100%;
    text-align: center;
}
#feedback-buttons {
    width: 100%;
    height: auto;
    align: right middle;
    margin-top: 1;
}
#btn-feedback-cancel {
    border: round #555555;
    background: transparent;
    color: $muted;
    height: 3;
    text-style: dim;
    margin-right: 1;
}
#btn-feedback-submit {
    border: round $brand;
    background: transparent;
    color: $brand;
    height: 3;
}
#btn-feedback-cancel:focus, #btn-feedback-cancel.-active,
#btn-feedback-submit:focus, #btn-feedback-submit.-active { background: transparent; }
#btn-feedback-submit:hover    { background: #3a2200; }
#btn-feedback-submit:disabled { color: #444444; border: round #333333; }


/* ============================================================
   AgentSessionScreen — sub-widgets
   ============================================================ */

UserMessage {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}
UserMessage .msg-content {
    height: auto;
    padding: 0 1;
    border-left: heavy $brand;
    color: $brand;
    text-style: bold;
}

CopyableCodeBlock {
    width: 100%;
    height: auto;
    margin: 1 0 1 0;
}
CopyableCodeBlock .cb-header {
    width: 100%;
    height: 1;
    align: left middle;
}
CopyableCodeBlock .cb-lang {
    width: 1fr;
    height: 1;
}
CopyableCodeBlock .cb-btn {
    height: 1;
    width: auto;
    min-width: 0;
    padding: 0 1;
    background: transparent;
    border: none;
    color: #555555;
}
CopyableCodeBlock .cb-btn:hover   { color: $brand; }
CopyableCodeBlock .cb-btn.-active { background: transparent; }
CopyableCodeBlock .cb-body {
    width: 100%;
    height: auto;
    padding: 0 1;
    background: $bg-raised;
    color: #cccccc;
}

BackgroundStep {
    width: 100%;
    height: auto;
}
BackgroundStep .step-header {
    width: 100%;
    height: 1;
    padding: 0 1;
    text-style: underline;
}
BackgroundStep .step-content {
    width: 100%;
    height: auto;
    padding: 0 0 0 4;
}
BackgroundStep .step-text {
    width: 100%;
    height: auto;
    color: #505050;
}

FinalAnswer {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}
FinalAnswer .final-sep {
    width: 100%;
    height: 1;
    padding: 0 1;
}
FinalAnswer .final-content {
    width: 100%;
    height: auto;
    padding: 0 1;
}
FinalAnswer .step-text {
    width: 100%;
    height: auto;
    color: #ffffff;
}

AssistantBlock {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}
AssistantBlock Static {
    width: 100%;
    height: auto;
    padding: 0 1;
}


/* ============================================================
   AgentSessionScreen
   ============================================================ */

#topic-context {
    height: 1;
    width: 100%;
    padding: 0 1;
    color: $muted;
}

AgentSessionScreen {
    background: $bg;
}
#session-bar {
    height: 4;
    background: $bg-raised;
    border-bottom: solid $brand;
    padding: 0 1;
    align: left middle;
}
#session-title {
    width: 1fr;
    height: 3;
    content-align: center middle;
    color: $brand;
    text-style: bold;
}
#session-bar Button {
    background: transparent;
    padding: 0 1;
    min-width: 0;
    height: 3;
}
#session-bar Button:focus,
#session-bar Button.-active {
    background: transparent;
}
AgentSessionScreen #btn-back           { color: #aaaaaa; border: round #444444; text-style: dim; }
#btn-stop                              { color: $hard;   border: round $hard; }
#btn-copy                              { color: $easy;   border: round $easy; }
#btn-copy:disabled                     { color: #333333; border: round #333333; }
AgentSessionScreen #btn-reset          { color: $muted; border: round #444444; text-style: dim; }
AgentSessionScreen #btn-reset:disabled { color: #333333; border: round #333333; }
#prior-history {
    width: 100%;
    height: auto;
    background: $bg-card;
    border-bottom: solid #333333;
    padding: 0 1 1 1;
    display: none;
}
#prior-history-title {
    color: #555555;
    text-style: italic;
    padding: 0 1;
    margin-bottom: 1;
}
#session-body {
    height: 1fr;
    width: 100%;
}
#description-panel {
    width: 45%;
    height: 100%;
    background: #0d0d0d;
    border-right: solid #333333;
    padding: 0 1 1 1;
    display: none;
}
#interview-opening {
    width: 100%;
    height: auto;
    padding: 1 0 0 0;
    border-top: solid #333333;
    color: #cccccc;
    margin-top: 1;
}
ChatScroll {
    height: 100%;
    width: 1fr;
    background: transparent;
}
#messages {
    width: 100%;
    height: auto;
    padding: 0 1 1 1;
}
#chat-input-container {
    height: auto;
    width: 100%;
    padding: 0 1 0 1;
    background: transparent;
}
#input-box {
    height: auto;
    width: 100%;
    background: transparent;
}
AgentSessionScreen #chat-input {
    width: 1fr;
    background: $bg;
    color: white;
    border: round #444444;
}
AgentSessionScreen #chat-input:focus    { background: $bg; background-tint: transparent; border: round $brand; color: white; }
AgentSessionScreen #chat-input.-focused { background: $bg; background-tint: transparent; border: round $brand; color: white; }
AgentSessionScreen #chat-input:disabled { color: #555555; border: round #2a2a2a; }
#btn-send {
    width: auto;
    height: 3;
    border: round $brand;
    background: transparent;
    color: $brand;
    padding: 0 2;
    min-width: 6;
    content-align: center middle;
}
#btn-send:focus, #btn-send.-active { background: transparent; }
#btn-send:disabled { color: #444444; border: round #444444; }
#session-status { background: $bg; }


/* ============================================================
   PlaybookBreadcrumb / PlaybookChatPanel / ReferenceGuideScreen
   ============================================================ */


PlaybookChatPanel {
    width: 27.5%;
    display: none;
    border: round #333333;
    background: $bg;
    margin-left: 1;
    overflow: hidden hidden;
}
PlaybookChatPanel.open {
    display: block;
}
PlaybookChatPanel.open.expanded {
    width: 55%;
}
PlaybookChatPanel #chat-log {
    width: 100%;
    height: 1fr;
    scrollbar-size: 0 0;
    padding: 1 1;
    scrollbar-size: 1 1;
    background: transparent;
    overflow-x: hidden;
}
ThinkingIndicator {
    display: none;
    height: 1;
    padding: 0 1;
}
PlaybookChatPanel #chat-input {
    height: 3;
    border: round #444444;
    background: $bg;
    padding: 0 2;
    color: white;
}
PlaybookChatPanel #chat-input:focus    { background: $bg; background-tint: transparent; border: round $brand; color: white; }
PlaybookChatPanel #chat-input.-focused { background: $bg; background-tint: transparent; border: round $brand; color: white; }
PlaybookChatPanel #chat-input:disabled { color: #555555; border: round #2a2a2a; }
#chat-header {
    height: 4;
    padding: 0 1;
    align: left middle;
}
#chat-header-spacer {
    width: 1fr;
}
PlaybookChatPanel .chat-expand-btn {
    width: auto;
    height: 3;
    min-width: 3;
    background: transparent;
    border: round #444444;
    color: #555555;
    padding: 0 1;
    text-style: bold;
}
PlaybookChatPanel .chat-expand-btn:hover  { color: #FF8205; border: round #FF8205; }
PlaybookChatPanel .chat-expand-btn:focus,
PlaybookChatPanel .chat-expand-btn.-active { background: transparent; }
PlaybookChatPanel .chat-reset-btn {
    min-width: 3;
    height: 3;
    background: transparent;
    border: round #444444;
    color: #555555;
    padding: 0 1;
    text-style: bold;
}
PlaybookChatPanel .chat-reset-btn:hover  { color: #FF8205; border: round #FF8205; }
PlaybookChatPanel .chat-reset-btn:focus,
PlaybookChatPanel .chat-reset-btn.-active { background: transparent; }

ReferenceGuideScreen {
    background: $bg;
}
#ref-filter-bar {
    height: auto;
    background: transparent;
    padding: 0 1;
    align: left middle;
}
#cat-filter {
    width: 22;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}
#cat-filter:focus-within,
#cat-filter.filter-active {
    border: round $grad2;
    color: $grad2;
}
#tier-filter {
    width: 22;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}
#tier-filter:focus-within,
#tier-filter.filter-active {
    border: round $grad3;
    color: $grad3;
}
#topic-search {
    width: 1fr;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}
#topic-search:focus,
#topic-search.filter-active {
    border: round $grad5;
    color: $grad5;
}
#topic-search > .input--placeholder { color: $muted; }
#cat-filter > SelectCurrent,
#tier-filter > SelectCurrent { overflow: hidden; border: none; padding: 0 1; color: $muted; }
#cat-filter > SelectCurrent > #label,
#tier-filter > SelectCurrent > #label { overflow: hidden; color: $muted; }
#cat-filter:focus-within > SelectCurrent,
#cat-filter.filter-active > SelectCurrent { color: $grad2; }
#tier-filter:focus-within > SelectCurrent,
#tier-filter.filter-active > SelectCurrent { color: $grad3; }
#cat-filter:focus-within > SelectCurrent > #label,
#cat-filter.filter-active > SelectCurrent > #label { color: $grad2; }
#tier-filter:focus-within > SelectCurrent > #label,
#tier-filter.filter-active > SelectCurrent > #label { color: $grad3; }
ReferenceGuideScreen #ref-body {
    height: 1fr;
    padding: 0 1 1 1;
}
ReferenceGuideScreen #ref-topics {
    width: 17.5%;
    border: round #333333;
    background: $bg;
    padding: 0;
    margin-right: 1;
}
#sidebar-header {
    height: 3;
    background: $bg;
    border-bottom: solid $grad5;
    content-align: left middle;
    padding: 0 2;
}
#ref-topics OptionList {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
    scrollbar-size: 1 1;
}
#ref-topics .option-list--option {
    padding: 0 1;
    color: $text;
}
#ref-topics .option-list--option-highlighted {
    background: $brand;
    color: #000000;
    text-style: bold;
}
#ref-topics .option-list--option-disabled {
    color: $amber;
    text-style: bold;
    background: #1a0a00;
    padding: 0 1;
}
#ref-center {
    width: 1fr;
    height: 1fr;
}
#ref-content-scroll {
    width: 1fr;
    height: 1fr;
    border: round #333333;
    padding: 0 2 1 2;
    scrollbar-size: 1 1;
}
NotesPanel {
    display: none;
    height: 11;
    width: 1fr;
    border: round #333333;
    background: $bg;
}
NotesPanel.open {
    display: block;
}
#notes-hint {
    height: 1;
    padding: 0 2;
    color: $muted;
}
#notes-textarea {
    height: 1fr;
    background: $bg;
    border: none;
    padding: 0 2;
    scrollbar-size: 0 0;
}
#ref-content-title {
    width: 100%;
    height: auto;
}
#ref-content-body {
    width: 100%;
    height: auto;
}
#ref-status {
    background: $bg;
}
