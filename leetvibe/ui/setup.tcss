/* ── Onboarding app — global ── */

$brand:    #FF8205;
$muted:    #888888;
$bg-card:  #0e0e0e;
$bg-input: #1a1a1a;

Screen {
    background: #0f0f0f;
    align: center middle;
}

/* ── Shared card container ── */

#api-container,
#auth-container,
#form-container {
    width: 64;
    height: auto;
    padding: 2 4;
    border: round #333333;
    background: $bg-card;
}

/* ── Welcome ── */

#hint {
    color: $muted;
    text-align: center;
    width: 100%;
    margin-top: 2;
}

/* ── API key / ElevenLabs key ── */

#api-title {
    color: $brand;
    text-style: bold;
    text-align: center;
    width: 100%;
    margin-bottom: 2;
}

#api-description {
    color: #cccccc;
    text-align: center;
    width: 100%;
    margin-bottom: 2;
    height: auto;
}

#link-hint {
    color: $muted;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

/* ── Shared input style (api-key screen + login/signup forms) ── */

#api-key-input,
.form-input {
    width: 100%;
    border: tall #444444;
    background: $bg-input;
    color: #ffffff;
    margin-bottom: 1;
}

#api-key-input:focus,
.form-input:focus {
    border: tall $brand;
}

/* ── Shared error label (api-key screen + login/signup forms) ── */

#error-label,
#form-error {
    color: #ff4444;
    text-align: center;
    width: 100%;
    height: 1;
}

#submit-hint {
    dock: bottom;
    text-align: center;
    width: 100%;
    padding: 1 0;
    color: $muted;
}

/* ── Auth choice ── */

#auth-title {
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

#auth-subtitle {
    color: $muted;
    text-align: center;
    width: 100%;
    margin-bottom: 2;
    height: auto;
}

.auth-btn {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    border: round #444444;
    background: transparent;
    color: #cccccc;
}

.auth-btn:hover,
.auth-btn:focus,
.auth-btn.-active {
    border: round $brand;
    background: transparent;
    color: $brand;
}

#auth-note {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $muted;
    text-align: center;
}

#auth-hint {
    dock: bottom;
    text-align: center;
    width: 100%;
    padding: 1 0;
    color: $muted;
}

/* ── Login / Signup / Google auth ── */

#form-title {
    color: $brand;
    text-style: bold;
    text-align: center;
    width: 100%;
    margin-bottom: 2;
}

#form-hint {
    color: $muted;
    text-align: center;
    width: 100%;
    margin-top: 1;
}
