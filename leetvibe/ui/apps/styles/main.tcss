/* ============================================================
   LeetVibe TUI — Fire-gradient dark theme
   ============================================================ */

/* --- Color palette --- */
$grad1: #FFD700;
$grad2: #FFAF00;
$grad3: #FF8205;
$grad4: #FA500F;
$grad5: #E92700;

$brand: #FF8205;
$easy: #00C44F;
$hard: #E53935;
$error: #ff4444;
$blue: #4A9EFF;
$trading: #00BCD4;
$amber: #FFB300;

/* Text ramp (brightest → faintest) */
$text-bright: white;
$text: #e0e0e0;
$text-dim: #aaaaaa;
$muted: #888888;

$bg: #121212;
$bg-card: #0e0e0e;
$bg-raised: #1a1a1a;

/* Neutral gray ramp (darkest → lightest) — shared across borders, text, and fills */
$gray1: #2a2a2a;
$gray2: #333333;
$gray3: #444444;
$gray4: #555555;


/* ============================================================
   Global
   ============================================================ */

Screen {
    background: $bg;
    color: $text;
}


/* ============================================================
   HomeScreen
   ============================================================ */

#home-banner {
    text-align: center;
    height: auto;
    padding: 1 4;
    color: $grad1;
}

#home-scroll {
    height: 1fr;
    align: center middle;
}

#home-content {
    height: auto;
    width: auto;
    align: center middle;
}

#home-center {
    width: auto;
    height: auto;
    align: center middle;
    padding: 1 4;
}

#main-menu {
    width: auto;
    border: round $brand;
    background: transparent;
    padding: 1 2;
}

#main-menu > .option-list--option {
    padding: 0 1;
    color: $text;
}

#main-menu > .option-list--option-highlighted {
    background: $brand;
    color: #000000;
    text-style: bold;
}

#home-status {
    color: $muted;
}



/* ============================================================
   ProblemListScreen
   ============================================================ */

/* ── filters and search bar container ── */
#list-header {
    height: auto;
    background: transparent;
    padding: 0 1;
    align: left middle;
}

/* ── difficulty-filter  (grad1 GOLD) ── */
#difficulty-filter {
    width: 22;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}

#difficulty-filter:focus-within,
#difficulty-filter.filter-active {
    border: round $grad1;
    color: $grad1;
}

#difficulty-filter > SelectCurrent,
#topic-filter > SelectCurrent,
#solved-filter > SelectCurrent { overflow: hidden; border: none; padding: 0 1; color: $muted; }
#feedback-type > SelectCurrent { overflow: hidden; border: none; padding: 0 1; }

#difficulty-filter > SelectCurrent > #label,
#topic-filter > SelectCurrent > #label,
#solved-filter > SelectCurrent > #label { overflow: hidden; color: $muted; }
#feedback-type > SelectCurrent > #label { overflow: hidden; }

#difficulty-filter:focus-within > SelectCurrent,
#difficulty-filter.filter-active > SelectCurrent { color: $grad1; }
#difficulty-filter:focus-within > SelectCurrent > #label,
#difficulty-filter.filter-active > SelectCurrent > #label { color: $grad1; }

#topic-filter:focus-within > SelectCurrent,
#topic-filter.filter-active > SelectCurrent { color: $grad2; }
#topic-filter:focus-within > SelectCurrent > #label,
#topic-filter.filter-active > SelectCurrent > #label { color: $grad2; }

#solved-filter:focus-within > SelectCurrent,
#solved-filter.filter-active > SelectCurrent { color: $grad3; }
#solved-filter:focus-within > SelectCurrent > #label,
#solved-filter.filter-active > SelectCurrent > #label { color: $grad3; }

/* ── topic-filter  (grad2 HONEY) ── */
#topic-filter {
    width: 26;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}

#topic-filter:focus-within,
#topic-filter.filter-active {
    border: round $grad2;
    color: $grad2;
}

/* ── solved-filter  (grad3 FIRE) ── */
#solved-filter {
    width: 20;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}

#solved-filter:focus-within,
#solved-filter.filter-active {
    border: round $grad3;
    color: $grad3;
}

/* ── btn-solution-toggle  (grad4 EMBER) ── */
#btn-solution-toggle {
    width: auto;
    min-width: 18;
    height: 3;
    margin: 0 1;
    border: round $muted;
    background: transparent;
    color: $muted;
    content-align: center middle;
}

#btn-solution-toggle:hover {
    border: round $grad4;
    color: $grad4;
}

#btn-solution-toggle.sol-active {
    color: $grad4;
    border: round $grad4;
}

/* ── search-input  (grad5 LAVA) ── */
#search-input {
    width: 1fr;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}

#search-input:focus,
#search-input.filter-active {
    border: round $grad5;
    color: $grad5;
}

/* ── Problem Table── */

ProblemTable {
    height: 1fr;
    background: transparent;
    border: round $muted;
    overflow-x: auto;
}

ProblemTable > .datatable--header {
    background: $bg-raised;
}

ProblemTable > .datatable--cursor {
    background: $brand;
    color: #000000;
    text-style: bold;
}

ProblemTable > .datatable--even-row {
    background: transparent;
}

ProblemTable > .datatable--odd-row {
    background: transparent;
}

#list-status {
    color: $muted;
}


/* ============================================================
   ProblemWorkspaceScreen
   ============================================================ */

/* ── Top bar ── */
#top-bar {
    height: 4;
    background: transparent;
    padding: 0 1;
}

#nav-section    { width: 1fr; align: left middle; }
#action-section { width: 1fr; align: center middle; }
#sol-section    { width: 1fr; align: right middle; }

#btn-problem-list, #btn-prev, #btn-next,
#btn-run, #btn-submit, #btn-feedback, #btn-solution {
    background: transparent;
    padding: 0 1;
    min-width: 0;
    height: 3;
}

/* ID-level :focus needed — the global Button:focus (0,1,1) loses to the
   text-style:dim set at ID specificity (1,0,0) on the nav/solution buttons. */
#btn-problem-list:focus, #btn-prev:focus, #btn-next:focus,
#btn-run:focus, #btn-submit:focus, #btn-feedback:focus, #btn-solution:focus,
#btn-problem-list.-active, #btn-prev.-active, #btn-next.-active,
#btn-run.-active, #btn-submit.-active, #btn-feedback.-active, #btn-solution.-active {
    text-style: bold;
}

#btn-problem-list, #btn-prev, #btn-next { color: $muted; border: round $gray3; text-style: dim; }
#btn-prev:disabled, #btn-next:disabled  { color: $gray3; border: round $gray1; }
#btn-run                                { color: $easy;  border: round $easy; }
#btn-submit                             { color: $blue;  border: round $blue; }
#btn-feedback                           { color: $muted; border: round $muted; }
#btn-solution                           { color: $grad1; border: round #7A6500; text-style: dim; }

#btn-submit:disabled { color: $gray3; border: round $gray3; }

/* ── Main body ── */
#detail-body {
    height: 1fr;
    padding: 0 1;
    margin-bottom: 2;
}

/* ── Left panel ── */
#left-panel {
    width: 1fr;
    border: round $brand;
    margin: 0 1 0 0;
}
#left-scroll {
    height: 1fr;
    padding: 1 2;
}

/* ── Right panel ── */
#right-panel {
    width: 1fr;
    margin: 0 0 0 1;
}

#editor-panel {
    height: 4fr;
    border: round $brand;
}
/* No inner border, blurred or focused — the fire cursor block is enough of a
   focus indicator, and a second border competing with #editor-panel's own
   round $brand frame just reads as visual noise. */
#code-editor          { height: 1fr; border: none; }
#code-editor:focus    { height: 1fr; border: none; }

/* ── Bottom tabs ── */
#console-tabs               { height: 1fr; border: round $brand; }
#test-cases-table, #test-results-table { height: 1fr; }

#solution-explanation {
    height: auto;
    color: $text;
    padding: 1 2;
    text-align: left;
}
#no-solution-msg {
    padding: 1 2;
    color: $muted;
    text-style: italic;
}

/* ── Utilities ── */
.hidden {
    display: none;
}

/* ============================================================
   Select widget
   ============================================================ */

Select {
    background: transparent;
    border: tall $muted;
    color: $text;
    width: 22;
}

Select > SelectCurrent {
    color: $text;
    background: transparent;
}

Select > SelectOverlay {
    background: transparent;
    border: tall $brand;
}

Select > SelectOverlay > .option-list--option {
    color: $text;
}

Select > SelectOverlay > .option-list--option-highlighted {
    background: $brand;
    color: #000000;
    text-style: bold;
}


/* ============================================================
   Input widget
   ============================================================ */

Input {
    background: transparent;
    border: tall $muted;
    color: $text;
}

Input:focus {
    border: tall $brand;
}

/* ── Feedback modal select override ── */
#feedback-type {
    width: 100%;
    border: round $muted;
}

#feedback-type:focus-within {
    border: round $brand;
}

/* ============================================================
   Loading indicator
   ============================================================ */

LoadingIndicator {
    color: $brand;
}


/* ============================================================
   Tooltip
   ============================================================ */

Tooltip {
    background: $bg-raised;
    color: $text;
    border: round $muted;
    padding: 0 1;
}


/* ============================================================
   Buttons — global
   ============================================================ */

/* Textual's default focus/active style is "bold reverse", which swaps a button's
   foreground into its background (solid colored fill). Individual buttons define
   their own focus/active look via border+color, so drop the fill globally and
   keep just the bold weight on focus. */
Button:focus, Button.-active {
    background: transparent;
}
Button:focus {
    text-style: bold;
}


/* ============================================================
   Banner widget
   ============================================================ */

Banner {
    text-align: center;
    padding: 1 2;
    height: auto;
}


/* ============================================================
   StatusBar / HintLabel widgets
   ============================================================ */

StatusBar {
    height: 1;
    background: transparent;
    padding: 0 2;
    dock: bottom;
}
StatusBar Label {
    color: $muted;
}
StatusBar #status-hints {
    width: auto;
    height: 1;
    padding: 0;
}
HintLabel {
    height: 1;
    width: auto;
    padding: 0 1;
    background: transparent;
}
HintLabel:hover {
    background: $gray1;
}
StatusBar .hint-sep {
    color: $gray4;
    width: auto;
    height: 1;
    padding: 0 0;
}
StatusBar #status-left   { width: 1fr; }
StatusBar #status-spacer { width: 1fr; }
StatusBar #status-right  { width: auto; }
StatusBar.hints-centered #status-count { width: 1fr; }
StatusBar.hints-centered #status-right { width: 1fr; text-align: right; }


/* ============================================================
   ProblemCard widget
   ============================================================ */

ProblemCard {
    height: auto;
    text-align: left;
}
ProblemCard #card-title {
    height: auto;
    padding: 0 0 1 0;
    color: $text-bright;
    text-style: bold;
    text-align: left;
}
ProblemCard #tags-row {
    height: auto;
}
ProblemCard .badge {
    height: 1;
    width: auto;
    padding: 0 1;
    margin: 0 1 0 0;
    background: $gray1;
    color: $text-dim;
}
ProblemCard .badge-easy    { background: #1a3a1a; color: $easy; }
ProblemCard .badge-medium  { background: #3a2a00; color: $amber; }
ProblemCard .badge-hard    { background: #3a1010; color: $hard; }
ProblemCard .badge-trading { background: #0a2a2a; color: $trading; }
ProblemCard #card-description {
    height: auto;
    color: $text;
    padding: 1 0;
    border-top: solid $gray2;
    margin-top: 1;
    text-align: left;
}
ProblemCard #hints-placeholder {
    color: $muted;
    text-style: italic;
    padding: 1 0;
    border-top: solid $gray2;
    margin-top: 1;
}
ProblemCard #hints-content {
    height: auto;
    color: $amber;
    padding: 1 0;
    border-top: solid $gray2;
    margin-top: 1;
}


/* ============================================================
   StatsScreen
   ============================================================ */

#stats-scroll {
    height: 1fr;
    padding: 1 2;
}
.stat-card {
    padding: 1 2;
    height: auto;
    background: $bg-card;
}
#progress-card {
    border: round $grad1;
    margin-bottom: 1;
}
#mid-row {
    height: 11;
    margin-bottom: 1;
}
#sessions-card {
    border: round $brand;
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}
#account-card {
    border: round $grad4;
    width: 1fr;
    height: 1fr;
}
#library-card {
    border: round $grad5;
    margin-top: 1;
}


/* ============================================================
   FeedbackModal
   ============================================================ */

FeedbackModal {
    align: center middle;
    background: $bg;
}
#feedback-dialog {
    width: 72;
    height: auto;
    background: $bg;
    border: round $gray2;
    padding: 2 3;
}
#feedback-title {
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}
#feedback-type-label {
    color: $muted;
    margin-bottom: 0;
}
#feedback-type {
    width: 100%;
    margin-bottom: 1;
    background: transparent;
}
#feedback-type > SelectCurrent {
    background: transparent;
}
#feedback-msg-label {
    color: $muted;
    margin-bottom: 0;
}
#feedback-text {
    width: 100%;
    height: 8;
    border: round $gray3;
    background: $bg;
    margin-bottom: 1;
}
#feedback-text:focus {
    border: round $brand;
}
#feedback-error {
    color: $error;
    height: auto;
    min-height: 1;
    width: 100%;
    text-align: center;
}
#feedback-buttons {
    width: 100%;
    height: auto;
    align: right middle;
    margin-top: 1;
}
#btn-feedback-cancel {
    border: round $gray4;
    background: transparent;
    color: $muted;
    height: 3;
    text-style: dim;
    margin-right: 1;
}
#btn-feedback-submit {
    border: round $brand;
    background: transparent;
    color: $brand;
    height: 3;
}
/* Same specificity trap as the detail top-bar buttons: the ID-level
   text-style:dim beats the global Button:focus bold. */
#btn-feedback-cancel:focus, #btn-feedback-cancel.-active { text-style: bold; }
#btn-feedback-submit:hover    { background: #3a2200; }
#btn-feedback-submit:disabled { color: $gray3; border: round $gray2; }


/* ============================================================
   ConfirmModal
   ============================================================ */

ConfirmModal {
    align: center middle;
    /* Translucent scrim so the screen behind (e.g. Home) stays dimly visible
       — this is a popup over that screen, not a second full screen. */
    background: $bg 70%;
}
#confirm-dialog {
    width: 60;
    height: auto;
    background: $bg;
    border: round $gray2;
    padding: 2 4;
}
#confirm-title {
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}
#confirm-subtitle {
    color: $muted;
    text-align: center;
    width: 100%;
    height: auto;
    margin-bottom: 2;
}
#confirm-buttons {
    width: 100%;
    height: auto;
    align: center middle;
}
#btn-confirm-cancel {
    border: round $gray4;
    background: transparent;
    color: $muted;
    height: 3;
    text-style: dim;
    margin: 0 2;
}
#btn-confirm-yes {
    border: round $hard;
    background: transparent;
    color: $hard;
    height: 3;
    margin: 0 2;
}
/* Same specificity trap as the detail top-bar buttons: the ID-level
   text-style:dim beats the global Button:focus bold. */
#btn-confirm-cancel:focus, #btn-confirm-cancel.-active { text-style: bold; }


/* ============================================================
   AgentSessionScreen
   ============================================================ */

#session-bar {
    height: 4;
    background: transparent;
    padding: 0 1;
    align: left middle;
}
/* Side columns size to their own content (width: auto) rather than a fixed
   1fr third — AgentSessionScreen._equalize_bar_columns() then measures both
   post-layout and sets them to match whichever is wider, so they stay equal
   (keeping the title centered) without permanently reserving a full third
   for a right column that may hold nothing at all (Copy Code + Reset are
   hidden in interview mode) and needlessly squeezing/wrapping the title. */
#session-bar-left, #session-bar-right {
    width: auto;
    height: 3;
}
#session-bar-left  { align: left middle; }
#session-bar-right { align: right middle; }
#session-title {
    width: 1fr;
    height: 3;
    content-align: center middle;
    text-align: center;
    color: $brand;
    text-style: bold;
}
#session-bar Button {
    background: transparent;
    padding: 0 1;
    min-width: 0;
    height: 3;
}
AgentSessionScreen #btn-back           { color: $muted; border: round $gray3; text-style: dim; }
#btn-copy                              { color: $easy;   border: round $easy; }
#btn-copy:disabled                     { color: $gray2; border: round $gray2; }
AgentSessionScreen #btn-reset          { color: $muted; border: round $gray3; text-style: dim; }
AgentSessionScreen #btn-reset:disabled { color: $gray2; border: round $gray2; }
/* Same specificity trap as the detail top-bar buttons: the ID-level
   text-style:dim beats the global Button:focus bold. */
AgentSessionScreen #btn-back:focus,  AgentSessionScreen #btn-back.-active,
AgentSessionScreen #btn-reset:focus, AgentSessionScreen #btn-reset.-active { text-style: bold; }
#session-body {
    height: 1fr;
    width: 100%;
}
/* Rounded box like #left-panel in ProblemWorkspaceScreen, but colored to
   match PlaybookChatPanel's border ($gray2) rather than the brand color. */
#description-panel {
    width: 45%;
    height: 100%;
    background: transparent;
    border: round $gray2;
    margin: 0 1 0 1;
    padding: 1 2;
    display: none;
}
#chat-column {
    width: 1fr;
    height: 100%;
}
/* Hidden until a resumed session sets it; Ctrl+R (action_show_history)
   hides it again once the prior conversation has been printed, so the hint
   doesn't linger after it's served its purpose. */
#resume-hint {
    width: 100%;
    height: auto;
    padding: 0 1;
    color: $gray4;
    display: none;
}
/* Transcript spans the same width as the input row below it: padding 0 1
   matches #chat-input-container, so bubble borders align with the Input's
   left edge and run to the Send button's side of the screen. Holds a mix of
   ChatBubbleLog segments (plain bubbles — user/mnemonic/error/follow-up) and
   mounted StepAnswerBubble widgets (Learn/Pair step answers, which need a
   live interactive Collapsible per step — RichLog can only ever rasterize a
   static write, so those can't be just another log segment). */
#chat-scroll {
    width: 100%;
    height: 1fr;
    background: transparent;
    padding: 0 1;
    scrollbar-size: 1 1;
}
/* Each segment sizes to its own content — RichLog with height:auto grows to
   fit everything written to it instead of clipping to a fixed viewport,
   which is what lets several of them stack cleanly inside #chat-scroll. */
AgentSessionScreen .bubble-log {
    width: 100%;
    height: auto;
    background: transparent;
    overflow-x: hidden;
}
AgentSessionScreen StepAnswerBubble {
    width: 100%;
    height: auto;
    border: round $brand;
    border-title-color: $brand;
    border-title-style: bold;
    border-title-align: left;
    background: transparent;
    padding: 0 1;
    margin-bottom: 1;
}
AgentSessionScreen StepAnswerBubble Collapsible {
    background: transparent;
    border-top: none;
    padding-bottom: 0;
    padding-left: 0;
}
/* Colors the whole CollapsibleTitle (arrow + label together, not just the
   text) per step, cycling through the brand gradient — see the grad-N
   classes assigned in StepAnswerBubble.compose(). */
AgentSessionScreen StepAnswerBubble Collapsible.grad-0 CollapsibleTitle,
AgentSessionScreen StepAnswerBubble Collapsible.grad-0 CollapsibleTitle:hover,
AgentSessionScreen StepAnswerBubble Collapsible.grad-0 CollapsibleTitle:focus {
    color: $grad1;
    text-style: bold;
}
AgentSessionScreen StepAnswerBubble Collapsible.grad-1 CollapsibleTitle,
AgentSessionScreen StepAnswerBubble Collapsible.grad-1 CollapsibleTitle:hover,
AgentSessionScreen StepAnswerBubble Collapsible.grad-1 CollapsibleTitle:focus {
    color: $grad2;
    text-style: bold;
}
AgentSessionScreen StepAnswerBubble Collapsible.grad-2 CollapsibleTitle,
AgentSessionScreen StepAnswerBubble Collapsible.grad-2 CollapsibleTitle:hover,
AgentSessionScreen StepAnswerBubble Collapsible.grad-2 CollapsibleTitle:focus {
    color: $grad3;
    text-style: bold;
}
AgentSessionScreen StepAnswerBubble Collapsible.grad-3 CollapsibleTitle,
AgentSessionScreen StepAnswerBubble Collapsible.grad-3 CollapsibleTitle:hover,
AgentSessionScreen StepAnswerBubble Collapsible.grad-3 CollapsibleTitle:focus {
    color: $grad4;
    text-style: bold;
}
AgentSessionScreen StepAnswerBubble Collapsible.grad-4 CollapsibleTitle,
AgentSessionScreen StepAnswerBubble Collapsible.grad-4 CollapsibleTitle:hover,
AgentSessionScreen StepAnswerBubble Collapsible.grad-4 CollapsibleTitle:focus {
    color: $grad5;
    text-style: bold;
}
#session-thinking {
    width: 100%;
}
#chat-input-container {
    height: auto;
    width: 100%;
    padding: 0 1 0 1;
    background: transparent;
}
#input-box {
    height: auto;
    width: 100%;
    background: transparent;
}
AgentSessionScreen #chat-input {
    width: 1fr;
    background: $bg;
    color: $text-bright;
    border: round $gray3;
}
AgentSessionScreen #chat-input:focus    { background: $bg; background-tint: transparent; border: round $brand; color: $text-bright; }
AgentSessionScreen #chat-input.-focused { background: $bg; background-tint: transparent; border: round $brand; color: $text-bright; }
AgentSessionScreen #chat-input:disabled { color: $gray4; border: round $gray1; }
#btn-send {
    width: auto;
    height: 3;
    border: round $brand;
    background: transparent;
    color: $brand;
    padding: 0 2;
    min-width: 6;
    content-align: center middle;
}
#btn-send.-stop    { color: $hard; border: round $hard; }
#btn-send:disabled { color: $gray3; border: round $gray3; }


/* ============================================================
   PlaybookChatPanel / PlaybookScreen
   ============================================================ */


PlaybookChatPanel {
    width: 27.5%;
    display: none;
    border: round $gray2;
    background: $bg;
    margin-left: 1;
    overflow: hidden hidden;
}
PlaybookChatPanel.open {
    display: block;
}
PlaybookChatPanel.open.expanded {
    width: 55%;
}
PlaybookChatPanel #chat-log {
    width: 100%;
    height: 1fr;
    padding: 1 1;
    scrollbar-size: 1 1;
    background: transparent;
    overflow-x: hidden;
}
ThinkingIndicator {
    display: none;
    height: 1;
    padding: 0 1;
}
PlaybookChatPanel #chat-input {
    height: 3;
    border: round $gray3;
    background: $bg;
    padding: 0 2;
    color: $text-bright;
}
PlaybookChatPanel #chat-input:focus    { background: $bg; background-tint: transparent; border: round $brand; color: $text-bright; }
PlaybookChatPanel #chat-input.-focused { background: $bg; background-tint: transparent; border: round $brand; color: $text-bright; }
PlaybookChatPanel #chat-input:disabled { color: $gray4; border: round $gray1; }
#chat-header {
    height: 4;
    padding: 0 1;
    align: left middle;
}
#chat-header-spacer {
    width: 1fr;
}
PlaybookChatPanel .chat-expand-btn {
    height: 3;
    min-width: 3;
    background: transparent;
    border: round $gray3;
    color: $gray4;
    text-style: bold;
}
PlaybookChatPanel .chat-expand-btn:hover  { color: $brand; border: round $brand; }
PlaybookChatPanel .chat-reset-btn {
    min-width: 3;
    height: 3;
    background: transparent;
    border: round $gray3;
    color: $gray4;
    text-style: bold;
}
PlaybookChatPanel .chat-reset-btn:hover  { color: $brand; border: round $brand; }

#ref-filter-bar {
    height: auto;
    background: transparent;
    padding: 0 1;
    align: left middle;
}
#cat-filter {
    width: 22;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}
#cat-filter:focus-within,
#cat-filter.filter-active {
    border: round $grad2;
    color: $grad2;
}
#tier-filter {
    width: 22;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}
#tier-filter:focus-within,
#tier-filter.filter-active {
    border: round $grad3;
    color: $grad3;
}
#topic-search {
    width: 1fr;
    margin: 0 1;
    border: round $muted;
    color: $muted;
}
#topic-search:focus,
#topic-search.filter-active {
    border: round $grad5;
    color: $grad5;
}
#topic-search > .input--placeholder { color: $muted; }
#cat-filter > SelectCurrent,
#tier-filter > SelectCurrent { overflow: hidden; border: none; padding: 0 1; color: $muted; }
#cat-filter > SelectCurrent > #label,
#tier-filter > SelectCurrent > #label { overflow: hidden; color: $muted; }
#cat-filter:focus-within > SelectCurrent,
#cat-filter.filter-active > SelectCurrent { color: $grad2; }
#tier-filter:focus-within > SelectCurrent,
#tier-filter.filter-active > SelectCurrent { color: $grad3; }
#cat-filter:focus-within > SelectCurrent > #label,
#cat-filter.filter-active > SelectCurrent > #label { color: $grad2; }
#tier-filter:focus-within > SelectCurrent > #label,
#tier-filter.filter-active > SelectCurrent > #label { color: $grad3; }
PlaybookScreen #ref-body {
    height: 1fr;
    padding: 0 1 1 1;
}
PlaybookScreen #ref-topics {
    width: 17.5%;
    border: round $gray2;
    background: $bg;
    padding: 0;
    margin-right: 1;
}
#sidebar-header {
    height: 3;
    border-bottom: solid $grad5;
    content-align: left middle;
    padding: 0 2;
}
#ref-topics OptionList {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
    scrollbar-size: 1 1;
}
#ref-topics .option-list--option {
    padding: 0 1;
    color: $text;
}
#ref-topics .option-list--option-highlighted {
    background: $brand;
    color: #000000;
    text-style: bold;
}
#ref-topics .option-list--option-disabled {
    color: $amber;
    text-style: bold;
    background: #1a0a00;
}
#ref-center {
    width: 1fr;
    height: 1fr;
}
#ref-content-scroll {
    width: 1fr;
    height: 1fr;
    border: round $gray2;
    padding: 0 2 1 2;
    scrollbar-size: 1 1;
}
NotesPanel {
    display: none;
    height: 11;
    width: 1fr;
    border: round $gray2;
    background: $bg;
}
NotesPanel.open {
    display: block;
}
#notes-hint {
    height: 1;
    padding: 0 2;
    color: $muted;
}
#notes-textarea {
    height: 1fr;
    background: $bg;
    border: none;
    padding: 0 2;
    scrollbar-size: 0 0;
}
#ref-content-title {
    width: 100%;
    height: auto;
}
#ref-content-body {
    width: 100%;
    height: auto;
}
