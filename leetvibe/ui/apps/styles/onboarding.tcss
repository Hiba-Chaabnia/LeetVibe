/* ── Onboarding app — global ── */

Screen {
    background: #0f0f0f;
    align: center middle;
}

/* ── Clickable key-hint rows (shared HintLabel widget) ── */

HintLabel {
    height: 1;
    width: auto;
    padding: 0 1;
    background: transparent;
}

HintLabel:hover {
    background: #2a2a2a;
}

.hint-sep {
    color: #555555;
    width: auto;
    height: 1;
}

/* ── Welcome ──
   ApiKeyScreen and ElevenLabsKeyScreen style themselves via their own
   CSS_PATH (key_screens.tcss) — self-sufficient across both this app and
   the main app, so nothing screen-specific for them lives here. */

Banner {
    width: 100%;
    height: auto;
    text-align: center;
}

#hint {
    width: 100%;
    height: 1;
    margin-top: 2;
    align: center middle;
}
